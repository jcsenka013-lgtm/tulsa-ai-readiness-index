# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Get these from your Supabase project: Project Settings -> API
# The URL and anon key are safe to ship to the browser.
# The service-role key is a privileged server-side secret — never expose it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# Admin dashboard (/admin) — HTTP Basic Auth. /admin is locked when unset.
# -----------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Sentry (optional — error reporting; tags product_type on scoped routes)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate limits: POST /api/assessment/create (per IP, per product, 15 min window)
# Copilot default is stricter. Disable only for local debugging.
# ASSESSMENT_CREATE_LIMIT_AI=20
# ASSESSMENT_CREATE_LIMIT_COPILOT=10
# ASSESSMENT_CREATE_RATE_LIMIT_DISABLED=true

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Used for absolute URLs in emails, PDFs, and magic-link callbacks.
# Production value lives in wrangler.jsonc `vars` (no trailing slash).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (Resend) + preview
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=results@tulsaappliedai.com
NEXT_PUBLIC_EMAIL_PREVIEW=false

# Calendly (optional — sensible defaults exist in code)
CALENDLY_DISCOVERY_URL=
CALENDLY_15MIN_URL=

# Signature / footer (optional)
EMAIL_SIGNATURE_NAME=Tulsa Applied AI
EMAIL_SIGNATURE_PHONE=
EMAIL_SIGNATURE_EMAIL=hello@tulsaappliedai.com
BUSINESS_ADDRESS=Tulsa, OK

# -----------------------------------------------------------------------------
# Slack (incoming webhooks)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL_LEADS=
SLACK_WEBHOOK_URL_ERRORS=

# -----------------------------------------------------------------------------
# Cron trigger auth (protects /api/cron/email-sequences)
# -----------------------------------------------------------------------------
CRON_SECRET=

# Optional: override Slack Supabase link
SUPABASE_DASHBOARD_PROJECT_URL=

# -----------------------------------------------------------------------------
# PDF report + contact (optional overrides)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/discovery
NEXT_PUBLIC_TAA_CONTACT_EMAIL=hello@tulsaappliedai.com
NEXT_PUBLIC_TAA_CONTACT_PHONE=
